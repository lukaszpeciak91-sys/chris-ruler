<Window x:Class="ChrisRuler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chris Ruler" Width="800" Height="120" MinWidth="370" MinHeight="66"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <!-- Window-local resources are replaced when this ruler's theme changes. -->
        <SolidColorBrush x:Key="FrameBrush" Color="#E01D3B4C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF58A5CE" />
        <SolidColorBrush x:Key="CalibrationBrush" Color="#FF86D0F2" />
        <SolidColorBrush x:Key="InnerBorderBrush" Color="#D94A8DAF" />
        <SolidColorBrush x:Key="OuterBorderBrush" Color="#A678A9C1" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#B3255570" />
        <SolidColorBrush x:Key="TextInputBackgroundBrush" Color="#E6255570" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#A678A9C1" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#CC387898" />
        <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#E67ABDDE" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#E620658A" />
        <SolidColorBrush x:Key="TextSelectionBrush" Color="#CC4FA2CC" />
        <SolidColorBrush x:Key="TextFocusBorderBrush" Color="#FF7ABDDE" />
        <Style x:Key="FocusGuideButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF2F6F8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FocusGuideToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF2F6F8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Lock guide" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TextFocusBorderBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="ToolTip" Value="Unlock guide" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScratchpadTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="160" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource TextInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF2F6F8" />
            <Setter Property="CaretBrush" Value="#FFF2F6F8" />
            <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
            <Setter Property="SelectionOpacity" Value="0.8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TextFocusBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- These 30/22/9 DIP bars are intentional row masks. Keep them synchronized
             with NativeOverlayWindowBehavior's geometry constants. -->
        <Rectangle Height="30" VerticalAlignment="Top" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
        <Rectangle Height="22" VerticalAlignment="Bottom" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
        <Rectangle Width="9" HorizontalAlignment="Left" Margin="0,30,0,22"
                   Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
        <Rectangle Width="9" HorizontalAlignment="Right" Margin="0,30,0,22"
                   Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />

        <!-- Static visual row-alignment aids; they do not participate in input or geometry. -->
        <Rectangle Height="1" VerticalAlignment="Top" Margin="9,29,9,0"
                   Fill="{DynamicResource CalibrationBrush}" IsHitTestVisible="False" />
        <Rectangle Height="1" VerticalAlignment="Bottom" Margin="9,0,9,21"
                   Fill="{DynamicResource CalibrationBrush}" IsHitTestVisible="False" />

        <Border Margin="1" BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="1" IsHitTestVisible="False" />
        <Border Margin="9,30,9,22" BorderBrush="{DynamicResource InnerBorderBrush}" BorderThickness="1" IsHitTestVisible="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="5,4,0,0">
            <Button x:Name="ColorSelectorButton" Style="{StaticResource FocusGuideButtonStyle}"
                    Margin="0,0,4,0" ToolTip="Change color" Click="ColorSelectorButton_Click">
                <Grid Width="12" Height="12">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}"
                             Stroke="#FFF2F6F8" StrokeThickness="1" />
                    <Ellipse Width="3" Height="3" Margin="6,0,0,6" Fill="#FFF2F6F8" />
                </Grid>
            </Button>
            <TextBox x:Name="ScratchpadTextBox" Style="{StaticResource ScratchpadTextBoxStyle}"
                     Margin="0,0,4,0" MaxLines="1" TextWrapping="NoWrap"
                     SpellCheck.IsEnabled="False" />
            <Button x:Name="CopyButton" Style="{StaticResource FocusGuideButtonStyle}"
                    ToolTip="Copy text" Click="CopyButton_Click">
                <Grid Width="11" Height="12">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" StrokeLineJoin="Miter"
                          Data="M 3.5,0.5 L 10.5,0.5 L 10.5,8.5 L 8.5,8.5 M 7.5,3.5 L 7.5,11.5 L 0.5,11.5 L 0.5,3.5 Z" />
                </Grid>
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,5,0">
            <ToggleButton x:Name="LockButton" Style="{StaticResource FocusGuideToggleButtonStyle}"
                          Margin="0,0,4,0" Click="LockButton_Click">
                <Grid Width="10" Height="12">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          Data="M 1,5 L 9,5 L 9,12 L 1,12 Z" />
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 3,5 L 3,3 C 3,0.5 7,0.5 7,3 L 7,5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                 Value="False">
                                        <Setter Property="Data" Value="M 3,5 L 3,3 C 3,0.5 7,0.5 7,3 L 7,5 M 7,1 L 9,1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </ToggleButton>
            <Button x:Name="UpRowButton" Style="{StaticResource FocusGuideButtonStyle}"
                    Margin="0,0,4,0" ToolTip="Previous row" Click="UpRowButton_Click">
                <Path Width="8" Height="5" Stretch="Fill"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 0,5 L 8,5 L 4,0 Z" />
            </Button>
            <Button x:Name="DownRowButton" Style="{StaticResource FocusGuideButtonStyle}"
                    Margin="0,0,4,0" ToolTip="Next row" Click="DownRowButton_Click">
                <Path Width="8" Height="5" Stretch="Fill"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 0,0 L 8,0 L 4,5 Z" />
            </Button>
            <Button x:Name="MinimizeButton" Style="{StaticResource FocusGuideButtonStyle}"
                    Margin="0,0,4,0" ToolTip="Minimize" Click="MinimizeButton_Click">
                <Path Width="8" Height="2" Stretch="Fill"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 0,0 L 8,0 L 8,2 L 0,2 Z" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource FocusGuideButtonStyle}"
                    ToolTip="Close" Click="CloseButton_Click">
                <Path Width="8" Height="8" Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                      Data="M 0,0 L 8,8 M 8,0 L 0,8" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
