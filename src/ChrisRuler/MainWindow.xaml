<Window x:Class="ChrisRuler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChrisRuler"
        Title="Chris Ruler" Width="800" Height="120" MinWidth="132" MinHeight="66"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="FocusGuideButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#332B8AC6" />
            <Setter Property="BorderBrush" Value="#667FA7BE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF2F6F8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#80509BC7" />
                    <Setter Property="BorderBrush" Value="#BFD0E9F5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC246C96" />
                    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FocusGuideToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#332B8AC6" />
            <Setter Property="BorderBrush" Value="#667FA7BE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFF2F6F8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Lock guide" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#80509BC7" />
                    <Setter Property="BorderBrush" Value="#BFD0E9F5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC246C96" />
                    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#CC246C96" />
                    <Setter Property="BorderBrush" Value="#FFD0E9F5" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="ToolTip" Value="Unlock guide" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Shared dimensions keep the mask, calibration lines, and native input hole aligned. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Static local:OverlayGeometry.TopBarHeightDip}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{x:Static local:OverlayGeometry.BottomBarHeightDip}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Static local:OverlayGeometry.SideBarWidthDip}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{x:Static local:OverlayGeometry.SideBarWidthDip}" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.ColumnSpan="3" Fill="#E024292D" IsHitTestVisible="False" />
        <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Fill="#E024292D" IsHitTestVisible="False" />
        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#E024292D" IsHitTestVisible="False" />
        <Rectangle Grid.Row="1" Grid.Column="2" Fill="#E024292D" IsHitTestVisible="False" />

        <Rectangle x:Name="TopCalibrationLine" Grid.Row="0" Grid.Column="1" Height="1"
                   VerticalAlignment="Bottom" Fill="#FF4FA3D1" Opacity="0.55"
                   SnapsToDevicePixels="True" IsHitTestVisible="False" />
        <Rectangle x:Name="BottomCalibrationLine" Grid.Row="2" Grid.Column="1" Height="1"
                   VerticalAlignment="Top" Fill="#FF4FA3D1" Opacity="0.55"
                   SnapsToDevicePixels="True" IsHitTestVisible="False" />

        <Border Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="1" BorderBrush="#665F6A71"
                BorderThickness="1" IsHitTestVisible="False" />

        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,5,0">
            <ToggleButton x:Name="LockButton" Style="{StaticResource FocusGuideToggleButtonStyle}"
                          Margin="0,0,4,0" Click="LockButton_Click">
                <Grid Width="10" Height="12">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          Data="M 1,5 L 9,5 L 9,12 L 1,12 Z" />
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 3,5 L 3,3 C 3,0.5 7,0.5 7,3 L 7,5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                 Value="False">
                                        <Setter Property="Data" Value="M 3,5 L 3,3 C 3,0.5 7,0.5 7,3 L 7,5 M 7,1 L 9,1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </ToggleButton>
            <Button x:Name="UpRowButton" Style="{StaticResource FocusGuideButtonStyle}"
                    Margin="0,0,4,0" ToolTip="Previous row" Click="UpRowButton_Click">
                <Path Width="8" Height="5" Stretch="Fill"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 0,5 L 8,5 L 4,0 Z" />
            </Button>
            <Button x:Name="DownRowButton" Style="{StaticResource FocusGuideButtonStyle}"
                    Margin="0,0,4,0" ToolTip="Next row" Click="DownRowButton_Click">
                <Path Width="8" Height="5" Stretch="Fill"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 0,0 L 8,0 L 4,5 Z" />
            </Button>
            <Button x:Name="CloseButton" ToolTip="Close" Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FocusGuideButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC9E342D" />
                                <Setter Property="BorderBrush" Value="#FFF0B4AF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF74231E" />
                                <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Width="8" Height="8" Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                      Data="M 0,0 L 8,8 M 8,0 L 0,8" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
