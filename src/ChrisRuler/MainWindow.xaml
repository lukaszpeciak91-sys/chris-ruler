<Window x:Class="ChrisRuler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chris Ruler"
        Width="800"
        Height="120"
        MinWidth="160"
        MinHeight="56"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="RulerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#2600325A" />
            <Setter Property="BorderBrush" Value="#59FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#59003E70" />
                    <Setter Property="BorderBrush" Value="#A6FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#80002545" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The four rectangles match the native window-region bars: 22/12 DIP
             horizontally and 10 DIP vertically. Their alpha is 70% (0xB3). -->
        <Rectangle Height="22" VerticalAlignment="Top" Fill="#B30078B8" IsHitTestVisible="False" />
        <Rectangle Height="12" VerticalAlignment="Bottom" Fill="#B30078B8" IsHitTestVisible="False" />
        <Rectangle Width="10" HorizontalAlignment="Left" Margin="0,22,0,12"
                   Fill="#B30078B8" IsHitTestVisible="False" />
        <Rectangle Width="10" HorizontalAlignment="Right" Margin="0,22,0,12"
                   Fill="#B30078B8" IsHitTestVisible="False" />

        <!-- Lightweight highlights add definition without effects or compositor APIs. -->
        <Border Margin="1" BorderBrush="#66FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
        <Border Margin="10,22,10,12" BorderBrush="#7300AEEF" BorderThickness="1" IsHitTestVisible="False" />

        <!-- Unitless orientation marks: every fifth mark is longer. -->
        <Rectangle Height="15" Margin="10,6,58,0" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,40,15" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#BFFFFFFF" Thickness="1" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0.5,4" EndPoint="0.5,15" />
                                        <LineGeometry StartPoint="8.5,9" EndPoint="8.5,15" />
                                        <LineGeometry StartPoint="16.5,9" EndPoint="16.5,15" />
                                        <LineGeometry StartPoint="24.5,9" EndPoint="24.5,15" />
                                        <LineGeometry StartPoint="32.5,9" EndPoint="32.5,15" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,2,4,0">
            <Button x:Name="NextRowButton"
                    Style="{StaticResource RulerButtonStyle}"
                    Margin="0,0,2,0"
                    ToolTip="Next row"
                    Click="NextRowButton_Click">▼</Button>
            <Button x:Name="CloseButton"
                    FontSize="15"
                    ToolTip="Close"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RulerButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B3C42B1C" />
                                <Setter Property="BorderBrush" Value="#CCFFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                ×
            </Button>
        </StackPanel>
    </Grid>
</Window>
