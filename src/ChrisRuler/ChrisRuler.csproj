    <Description>An always-on-top visual guide for Windows.</Description>
    <Company>Chris Ruler</Company>
    <Copyright>Copyright © 2026 Chris Ruler contributors</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
