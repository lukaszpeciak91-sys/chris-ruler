<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ChrisRuler</AssemblyName>
    <RootNamespace>ChrisRuler</RootNamespace>
    <Product>Chris Ruler</Product>
    <Description>An always-on-top visual guide for Windows.</Description>
    <Company>Chris Ruler</Company>
    <Copyright>Copyright © 2026 Chris Ruler contributors</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- The release icon is supplied separately by the repository owner. -->
  <PropertyGroup Condition="Exists('Assets\ChrisRuler.ico')">
    <ApplicationIcon>Assets\ChrisRuler.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);CHRIS_RULER_ICON</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Assets\ChrisRuler.ico')">
    <Resource Include="Assets\ChrisRuler.ico" />
  </ItemGroup>
</Project>
